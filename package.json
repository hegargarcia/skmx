{
  "name": "skill-sync",
  "version": "0.1.0",
  "description": "Keep agent skills and global instructions in sync through GitHub",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hegargarcia/skill-sync.git"
  },
  "bugs": "https://github.com/hegargarcia/skill-sync/issues",
  "homepage": "https://github.com/hegargarcia/skill-sync#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "skill-sync": "dist/index.js",
    "ss": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:package": "node scripts/smoke-package.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:package",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
